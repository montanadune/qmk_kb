# マイコンとブートローダーをRP2040に指定
MCU = RP2040
BOOTLOADER = rp2040

# 機能を有効化
BOOTMAGIC_ENABLE = yes
MOUSEKEY_ENABLE = yes
EXTRAKEY_ENABLE = yes
CONSOLE_ENABLE = no
COMMAND_ENABLE = no
NKRO_ENABLE = yes
RGBLIGHT_ENABLE = yes
POINTING_DEVICE_ENABLE = yes
POINTING_DEVICE_DRIVER = pmw3360

# 分割通信を完全にオフ
SPLIT_KEYBOARD = n
